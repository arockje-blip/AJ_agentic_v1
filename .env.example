# Copy this file to .env for local dev (vercel dev will pick it up).
# NEVER commit the real .env file — it's already in .gitignore.
#
# In production, set these in Vercel: Project Settings -> Environment Variables

# Required — used as the fallback if OpenRouter is unavailable/unconfigured.
GEMINI_API_KEY=your_new_gemini_key_here

# Optional but recommended — enables intent-based routing across OpenRouter's
# free models (coding/reasoning/research/etc). Get one at openrouter.ai/keys.
# If left unset, every request just goes straight to Gemini.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional — connect to a local Ollama server for local-first responses.
# Leave the default base URL unless you run Ollama somewhere else.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
